# ---- Site ----
NEXT_PUBLIC_SITE_NAME="Interactive Learning"

# ---- Supabase (required for the admin portal and saving content) ----
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Admin portal ----
# The password you type at /admin/login
ADMIN_PASSWORD=pick-a-long-password
# Any long random string (used to sign the admin cookie)
ADMIN_SESSION_SECRET=another-long-random-string

# ---- Claude ----
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Sign-in (leave false until you set it up; see README) ----
NEXT_PUBLIC_ENABLE_AUTH=false
# Notes uploads per student per day (each one is a Claude call on your API key)
UPLOADS_PER_DAY=5
